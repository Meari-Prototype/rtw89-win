; Copyright (c) 2026 Meari
;
; rtw89win.inf: Realtek RTL8852BE Wi-Fi (PCI\VEN_10EC&DEV_B852) on the ROCK 5T
; A WiFiCx (NetAdapterCx) network adapter, class Net. Every start runs as one, unless the crash loop guard tripped
; (Services\rtw89win\Parameters\BootAttempts, cleared by tools\rtwdiag.ps1 arm): then it starts in a read-only
; diagnostic mode without a network interface. Diagnostics on \\.\rtw89win (a control device) in both modes.
; The firmware (linux-firmware rtw89/rtw8852b_fw-2.bin, Realtek licence in firmware\) is installed next to the
; driver in the driver store, where the driver reads it (IoGetDriverDirectory).
; Network keywords follow the WiFiCx sample (microsoft/Windows-driver-samples network\wlan\wificx\km\wificxsampleclientkm.inf),
; with BusType PCI instead of internal.
; DriverVer is filled in by build.ps1.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGuid   = {4D36E972-E325-11CE-BFC1-08002BE10318}
Provider    = %Provider%
DriverVer   = 01/01/2026,0.0.0.0
CatalogFile = rtw89win.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
rtw89win.sys      = 1
rtw8852b_fw-2.bin = 1

[Manufacturer]
%Mfg% = Realtek, NTARM64.10.0...26100

[Realtek.NTARM64.10.0...26100]
%Rtw89.DeviceDesc% = Rtw89_Device, PCI\VEN_10EC&DEV_B852

[Rtw89_Device.NT]
CopyFiles          = Rtw89_CopyFiles
Characteristics    = 0x84            ; NCF_HAS_UI | NCF_PHYSICAL
BusType            = 5               ; PCIBus
AddReg             = Rtw89_Ndi_AddReg
*IfType            = 71              ; IF_TYPE_IEEE80211
*MediaType         = 16              ; NdisMediumNative802_11
*PhysicalMediaType = 9               ; NdisPhysicalMediumNative802_11

[Rtw89_CopyFiles]
rtw89win.sys
rtw8852b_fw-2.bin

[Rtw89_Ndi_AddReg]
HKR, Ndi,              Service,    0, "rtw89win"
HKR, Ndi\Interfaces,   UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces,   LowerRange, 0, "wlan,ethernet"
; standard keywords of NetAdapter drivers, as AddReg like the WiFiCx sample
HKR, NetworkInterface, *IfConnectorPresent, 0x00010001, 1
HKR, NetworkInterface, *ConnectionType,     0x00010001, 1     ; NET_IF_CONNECTION_DEDICATED
HKR, NetworkInterface, *DirectionType,      0x00010001, 0     ; NET_IF_DIRECTION_SENDRECEIVE
HKR, NetworkInterface, *AccessType,         0x00010001, 2     ; NET_IF_ACCESS_BROADCAST
HKR, NetworkInterface, *HardwareLoopback,   0x00010001, 0
; NDIS interfaces the Net class installer reserves for the device: the station port, and (with Parameters\WifiDirect
; on) the Wi-Fi Direct device port and one role (group owner) port for the mobile hotspot
HKR, ,                 NumberOfNetworkInterfaces, 0x00010001, 3

[Rtw89_Device.NT.Services]
AddService = rtw89win, 0x00000002, Rtw89_Service      ; SPSVCINST_ASSOCSERVICE

[Rtw89_Service]
DisplayName    = %Rtw89.SvcDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\rtw89win.sys
LoadOrderGroup = NDIS

[Rtw89_Device.NT.Wdf]
KmdfService = rtw89win, Rtw89_Wdf

[Rtw89_Wdf]
KmdfLibraryVersion = 1.33

[Strings]
Provider         = "rtw89win"
Mfg              = "Realtek"
DiskName         = "rtw89win"
Rtw89.DeviceDesc = "Realtek RTL8852BE Wi-Fi (rtw89win)"
Rtw89.SvcDesc    = "rtw89win RTL8852BE Wi-Fi driver"
